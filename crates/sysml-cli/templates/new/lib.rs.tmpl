/// Layer 3: reusable subsystem blueprints (`part def`), typed by layer-1 ports and satisfying
/// layer-2 requirements.
#[sysml::package(name = "{{PASCAL}}Subsystems")]
#[sysml::import("{{PASCAL}}Types::*")]
pub mod subsystems {
    use super::requirements::*;
    use super::types::*;
    use super::*;

    // TODO(subsystems): add one `#[sysml::part]` per diagram box HERE. Parts that share
    // features get an `#[sysml::part(abstract)]` parent + `#[sysml::specializes(...)]`.
    // Add `#[sysml::import("SI::*")]` to this package when you add `unit = "..."` attributes.
    // Put `#[sysml::satisfy(req = ..., id = "...")]` on the part that realizes each requirement
    // (system-level requirements with no single realizing subsystem go on the context part).

    /// Placeholder controlling subsystem (rename to match your diagram).
    #[sysml::part]
    #[sysml::satisfy(req = PlaceholderResponseTime, id = "SYS-REQ-001")]
    #[derive(Debug, Clone, Copy)]
    pub struct Controller {
        #[sysml::port]
        pub cmd_out: CommandPort,
        #[sysml::port]
        pub status_in: Conjugated<StatusPort>,
    }

    /// Placeholder controlled subsystem (rename to match your diagram).
    #[sysml::part]
    #[derive(Debug, Clone, Copy)]
    pub struct Actuator {
        #[sysml::port]
        pub cmd_in: Conjugated<CommandPort>,
        #[sysml::port]
        pub status_out: StatusPort,
    }
}

/// Layer 4: the single top-level context that composes and wires the subsystems.
#[sysml::package(name = "{{PASCAL}}Context")]
#[sysml::import("{{PASCAL}}Types::*")]
#[sysml::import("{{PASCAL}}Subsystems::*")]
pub mod context {
    use super::subsystems::*;
    use super::types::*;
    use super::*;

    // TODO(context): add each subsystem as a `#[sysml::part]` field and each diagram arrow
    // as a `#[sysml::connect(...)]` HERE. Keep exactly one top-level context part; with
    // more than 10 children, group them into intermediate subsystem parts in layer 2.

    /// Top-level system context: composes all subsystems and their connections.
    #[sysml::part]
    #[sysml::connect(
        interface = CommandLink,
        name = "controllerToActuator",
        from = controller.cmd_out,
        to = actuator.cmd_in
    )]
    #[sysml::connect(
        interface = StatusLink,
        name = "actuatorToController",
        from = actuator.status_out,
        to = controller.status_in
    )]
    #[derive(Debug, Clone, Copy)]
    pub struct {{PASCAL}}System {
        #[sysml::part]
        pub controller: Controller,
        #[sysml::part]
        pub actuator: Actuator,
    }
}

/// Assemble all `#[sysml::package]` modules (in layer order) into one `sysml_ir::Model`.
pub fn build_model() -> Model {
    Model::new(vec![
        types::sysml_package(),
        requirements::sysml_package(),
        subsystems::sysml_package(),
        context::sysml_package(),
    ])
}

#[cfg(test)]
mod tests {
    use super::*;
    use sysml_emit::{audit_model_with_stdlib, emit_model, lint_model};

    #[test]
    fn model_emits_and_audits_zero_errors_zero_warnings() {
        let model = build_model();
        let sysml = emit_model(&model);
        assert!(sysml.contains("package {{PASCAL}}Context"));

        let audit = audit_model_with_stdlib("{{SNAKE}}", &model, None, None, true);
        assert!(audit.stdlib_loaded, "OMG sysml.library must be loaded");
        assert!(
            audit.ok && audit.validation_errors == 0 && audit.validation_warnings == 0,
            "{{SNAKE}} audit failed: {audit:#?}\n--- SYSML ---\n{sysml}"
        );
    }

    #[test]
    fn model_is_lint_clean() {
        let report = lint_model("{{SNAKE}}", &build_model());
        assert!(report.clean, "lint findings: {:#?}", report.findings);
    }

    #[test]
    fn placeholder_requirement_constraint_executes() {
        let nominal = requirements::PlaceholderResponseTime {
            max_response_time: Quantity::new(1.0, "s"),
            measured_response_time: Quantity::new(0.5, "s"),
        };
        assert!(nominal.evaluate());
    }
}
