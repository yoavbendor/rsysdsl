//! `{{PASCAL}}` system model, scaffolded by `rsysdsl new`.
//!
//! Layered structure (keep it this way as the model grows):
//! 1. `{{PASCAL}}Types`        - payload items, ports, interfaces (the "arrows").
//! 2. `{{PASCAL}}Requirements` - requirements with document provenance.
//! 3. `{{PASCAL}}Subsystems`   - reusable part definitions (the "boxes"); each realizing part
//!    carries `#[sysml::satisfy(...)]` for the requirements it meets.
//! 4. `{{PASCAL}}Context`      - ONE top-level context part composing subsystems with `#[sysml::connect]`.
//!
//! A package may only use elements from packages listed above it. Using types (ports, items)
//! needs `#[sysml::import("<Package>::*")]` (SysML side) AND `use super::<module>::*;` (Rust side);
//! `#[sysml::satisfy]` of a requirement in another package needs only the Rust `use`.
//!
//! Verify after every change (`rsysdsl` = `cargo install --path crates/sysml-cli` in the rsysdsl
//! repo, or run it there as `cargo run -q -p sysml-cli -- ...`):
//! ```text
//! cargo test -p {{KEBAB}}
//! cargo run -q -p {{KEBAB}} --bin emit -- -o target/{{SNAKE}}.sysml
//! rsysdsl audit --files target/{{SNAKE}}.sysml --stdlib --strict --pretty
//! rsysdsl lint --files target/{{SNAKE}}.sysml --strict --format markdown
//! ```

use sysml_dsl::prelude::*;

/// Layer 1: payloads, ports and interfaces shared by every subsystem.
#[sysml::package(name = "{{PASCAL}}Types")]
#[sysml::import("ScalarValues::*")]
#[sysml::import("SI::*")]
pub mod types {
    use super::*;

    // TODO(types): add every payload (`#[sysml::item]`), port (`#[sysml::port]`) and
    // interface (`#[sysml::interface]`) HERE, never in the subsystem or context layers.
    // With 3+ interfaces, give them an abstract parent to keep `rsysdsl lint --strict` clean:
    // `#[sysml::interface(abstract)] pub struct {{PASCAL}}Channel {}` (no ends needed) plus
    // `#[sysml::specializes({{PASCAL}}Channel)]` on each interface. Never drop `interface = ...`
    // from a connect to silence the lint (that triggers `untyped_connections`).

    /// Placeholder command payload (rename to match your diagram's arrow label).
    #[sysml::item]
    #[derive(Debug, Clone, Copy, Default)]
    pub struct CommandSignal {
        #[sysml::attr(default = 0.0, unit = "W")]
        pub setpoint: Quantity<f64>,
    }

    /// Placeholder status payload (rename to match your diagram's arrow label).
    #[sysml::item]
    #[derive(Debug, Clone, Copy, Default)]
    pub struct StatusSignal {
        #[sysml::attr(default = 0.0, unit = "W")]
        pub measured: Quantity<f64>,
    }

    /// Directed command output port (connect to `Conjugated<CommandPort>`).
    #[sysml::port]
    #[derive(Debug, Clone, Copy, Default)]
    pub struct CommandPort {
        #[sysml::out_item]
        pub command: CommandSignal,
    }

    /// Directed status output port (connect to `Conjugated<StatusPort>`).
    #[sysml::port]
    #[derive(Debug, Clone, Copy, Default)]
    pub struct StatusPort {
        #[sysml::out_item]
        pub status: StatusSignal,
    }

    /// Typed interface carrying commands.
    #[sysml::interface]
    pub struct CommandLink {
        #[sysml::end]
        pub source: CommandPort,
        #[sysml::end]
        pub sink: Conjugated<CommandPort>,
    }

    /// Typed interface carrying status feedback.
    #[sysml::interface]
    pub struct StatusLink {
        #[sysml::end]
        pub source: StatusPort,
        #[sysml::end]
        pub sink: Conjugated<StatusPort>,
    }
}

